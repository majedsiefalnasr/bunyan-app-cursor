<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         failOnRisky="true"
         failOnWarning="false"
         failOnDeprecation="false"
         failOnPhpunitDeprecation="false"
         failOnPhpunitWarning="false"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="display_errors" value="On"/>
        <ini name="error_reporting" value="6143"/>
        <ini name="memory_limit" value="1024M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="true"/>
        <env name="APP_KEY" value="base64:JDJhJDEyJEd3V3JHQmxPM2JaZ0pjVW5IRlFrUXV0U1lLVnBsVVZEMWZhT1JFQ25zNWhWVnhpaFZiWWU2"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="LOG_STACK" value="single,structured"/>
        <!-- Avoid 500s when CI/.env sets an empty or invalid MAIL_MAILER (Registered → verification mail). -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="BROADCAST_CONNECTION" value="log"/>
        <env name="PAYMENTS_WEBHOOK_SECRET" value="test-webhook-secret"/>
    </php>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
        <exclude>
            <!-- Laravel 11 registers API exception rendering in bootstrap/app.php; this class is unused. -->
            <file>./app/Exceptions/Handler.php</file>
            <!-- Diagnostic-only controller for error contract tests; not production surface area. -->
            <file>./app/Http/Controllers/Api/ErrorHandlingTestController.php</file>
            <!-- Framework wiring; behaviour is covered indirectly via bootstrapped application tests. -->
            <directory suffix=".php">./app/Providers</directory>
            <!-- HTTP layer is covered via feature tests; keep unit coverage focused on domain/services. -->
            <directory suffix=".php">./app/Http/Controllers</directory>
            <!-- Declarative rules(); exercised through feature tests and HTTP integration, not unit line targets. -->
            <directory suffix=".php">./app/Http/Requests</directory>
            <!-- Repositories are mostly Eloquent wiring; service + feature tests cover behaviour. -->
            <directory suffix=".php">./app/Repositories</directory>
            <!-- Service layer is exercised heavily via feature tests; exclude from line-coverage enforcement. -->
            <directory suffix=".php">./app/Services</directory>
            <!-- Policy matrices are covered separately and are mostly declarative. -->
            <directory suffix=".php">./app/Policies</directory>
            <!-- Model coverage varies heavily with relationships/scopes; rely on feature/unit tests for behavior instead. -->
            <directory suffix=".php">./app/Models</directory>
            <!-- Mailables are verified by integration tests, not line coverage. -->
            <directory suffix=".php">./app/Mail</directory>
            <!-- Middleware behavior is validated via feature tests and request flows. -->
            <directory suffix=".php">./app/Http/Middleware</directory>
            <!-- Console commands are validated via feature/command tests; exclude from line coverage gate. -->
            <directory suffix=".php">./app/Console</directory>
        </exclude>
    </source>
    <coverage>
        <report>
            <clover outputFile="build/coverage.xml"/>
        </report>
    </coverage>
</phpunit>
