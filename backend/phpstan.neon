includes:
  - ./vendor/larastan/larastan/extension.neon

parameters:
  level: 5
  paths:
    - app
    - config
    - database
    - routes
    - tests
  bootstrapFiles:
    - ./tests/bootstrap.php
  checkMissingIterableValueType: false
  checkGenericClassInNonGenericObjectType: false
  ignoreErrors:
    - '#Access to an undefined property App\\Http\\Resources\\Api\\V1\\.+Resource::\$#'
