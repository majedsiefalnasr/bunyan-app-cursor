includes:
  - ./vendor/larastan/larastan/extension.neon

parameters:
  level: 5
  paths:
    - app
    - config
    - database
    - routes
    - tests
  bootstrapFiles:
    - ./tests/bootstrap.php
  checkMissingIterableValueType: false
  checkGenericClassInNonGenericObjectType: false
  ignoreErrors:
    - '#Access to an undefined property App\\Http\\Resources\\Api\\V1\\.+Resource::\$#'
    - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder.*::(active|byRole|byStatus|byProject|byPhase|byTask|byUser|byType|byCustomer|byCategory|bySku|inStock|pending|completed|assigned|assignedTo|forUser|active|scopeOrdered|withTrashed)\(\)\.#'
