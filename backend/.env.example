# Keep `ci.env` in sync when adding or renaming keys (GitHub Actions copies it to `.env`).
APP_NAME="Bunyan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL — default matches `docker-compose.yml` service `mysql` when connecting from your host
# (user `bunyan` / password `bunyan`, database `bunyan`). Use 127.0.0.1, not `mysql`, unless
# Artisan runs inside the Compose network.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bunyan
DB_USERNAME=bunyan
DB_PASSWORD=bunyan

# Alternative: MySQL `root` from Docker Desktop is often `root` / `root` (see compose MYSQL_ROOT_PASSWORD).
# DB_USERNAME=root
# DB_PASSWORD=root

# Local dev without MySQL — SQLite file:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

CACHE_DRIVER=redis
CACHE_PREFIX=bunyan_cache

QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@bunyan.local
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DOMAIN=localhost
SANCTUM_EXPIRATION=10080

API_PREFIX=api
API_VERSION=v1
