{
    "name": "bunyan-frontend",
    "version": "1.0.0",
    "description": "Bunyan - Arabic Construction Services Marketplace (Frontend)",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt build",
        "preview": "nuxt preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"./**/*.{vue,ts,js,mjs,cjs,json,css,md,mdc}\"",
        "format:check": "prettier --check \"./**/*.{vue,ts,js,mjs,cjs,json,css,md,mdc}\"",
        "fix": "npm run format && npm run lint:fix",
        "typecheck": "nuxi typecheck",
        "pretest": "nuxi prepare",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@iconify-json/heroicons": "^1.2.2",
        "@nuxt/ui": "^4.6.0",
        "@nuxtjs/i18n": "^9.5.6",
        "@pinia/nuxt": "^0.11.0",
        "@vueuse/core": "^10.10.0",
        "axios": "^1.7.0",
        "echarts": "^6.0.0",
        "nuxt": "^4.0.0",
        "pinia": "^3.0.4",
        "tailwindcss": "^4.1.0",
        "vee-validate": "^4.14.0",
        "vue-echarts": "^8.0.1",
        "zod": "^3.23.0"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.102",
        "@nuxt/eslint": "^1.15.2",
        "@nuxt/eslint-config": "^0.5.0",
        "@nuxt/test-utils": "^3.15.0",
        "@playwright/test": "^1.59.1",
        "@types/node": "^25.6.0",
        "@vitest/ui": "^3.2.4",
        "@vue/test-utils": "^2.4.0",
        "eslint": "^9.11.0",
        "eslint-config-prettier": "^10.1.8",
        "happy-dom": "^20.9.0",
        "prettier": "^3.3.0",
        "typescript": "^5.6.0",
        "vite": "7.3.2",
        "vitest": "^3.2.4",
        "vue-tsc": "^2.2.0"
    },
    "overrides": {
        "@nuxt/test-utils": {
            "happy-dom": "20.9.0"
        },
        "follow-redirects": "1.16.0"
    }
}
